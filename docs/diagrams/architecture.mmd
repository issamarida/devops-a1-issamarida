flowchart TB
    browser["Investor's browser"]
    subgraph process["One process: python app.py / waitress"]
        root["create_app<br/>Composition root"]
        access["Access control<br/>Login / CSRF / limits"]
        watch["WATCHLIST<br/>Routes / Service<br/>Repository"]
        alert["ALERTS<br/>Routes / Service<br/>Repository"]
        reader["WatchlistReader<br/>Same owner"]
        price["LivePrices<br/>PriceSource + snapshot"]
        quotes["/api/quotes, search, details<br/>Signed-in, own tickers only"]
        info["MarketInfo<br/>Market status / search / details<br/>Cached"]
        stream["Finnhub stream<br/>Daemon threads, app.py"]
        rest["Cached REST quotes<br/>Key in header"]
        poller["Daemon poller<br/>Started only by app.py"]
    end
    db[("SQLite<br/>DATA_DIR/app.db")]
    api["Finnhub REST API"]
    ws["Finnhub WebSocket"]
    browser --> access
    browser -. polls .-> quotes
    root -. wires .-> access
    root -. scopes .-> watch
    root -. scopes .-> alert
    access --> watch
    access --> alert
    poller --> alert
    alert --> reader
    watch -. satisfies .-> reader
    alert --> price
    quotes --> price
    price --> stream
    price --> rest
    stream --> ws
    stream -. watched tickers .-> watch
    rest --> api
    quotes --> info
    info --> api
    watch --> db
    alert --> db
    access --> db
    classDef support fill:#eef2fa,stroke:#7b90b3,color:#182337
    classDef feature fill:#e9f3ee,stroke:#4c8c6b,color:#182337
    class root,access,reader,poller,price,quotes,info,stream,rest support
    class watch,alert feature
