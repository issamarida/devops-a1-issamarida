flowchart TB
    browser["Investor's browser"]
    subgraph process["One process: python app.py / waitress"]
        root["create_app<br/>Composition root"]
        access["Access control<br/>Login / CSRF / limits"]
        watch["WATCHLIST<br/>Routes / Service<br/>Repository"]
        alert["ALERTS<br/>Routes / Service<br/>Repository"]
        reader["WatchlistReader<br/>Same owner"]
        price["PriceSource<br/>Cached Finnhub"]
        poller["Daemon poller<br/>Started only by app.py"]
    end
    db[("SQLite<br/>DATA_DIR/app.db")]
    api["Finnhub API"]
    browser --> access
    root -. wires .-> access
    root -. scopes .-> watch
    root -. scopes .-> alert
    access --> watch
    access --> alert
    poller --> alert
    alert --> reader
    watch -. satisfies .-> reader
    alert --> price
    price --> api
    watch --> db
    alert --> db
    access --> db
    classDef support fill:#eef2fa,stroke:#7b90b3,color:#182337
    classDef feature fill:#e9f3ee,stroke:#4c8c6b,color:#182337
    class root,access,reader,poller,price support
    class watch,alert feature
